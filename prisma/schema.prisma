// Billionaire Smile Club CRM — laborator dentar, offline, single-user.
// Sume în Int (bani / subunități monetare).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AppAuth {
  id           String   @id @default("singleton")
  passwordHash String
  updatedAt    DateTime @updatedAt
}

// Cabinete / medici stomatologi (fostul modul Clienți).
model Doctor {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  works     Work[]

  @@index([name])
}

model Technician {
  id         String   @id @default(cuid())
  name       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  worksAs1   Work[]   @relation("WorkTechnician1")
  worksAs2   Work[]   @relation("WorkTechnician2")
  worksAs3   Work[]   @relation("WorkTechnician3")

  @@index([name])
  @@index([active])
}

// Catalog tipuri lucrări — preț doctor vs preț tehnician (per bucată).
model WorkType {
  id              String     @id @default(cuid())
  name            String
  doctorPrice     Int
  technicianPrice Int
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  lines           WorkLine[]

  @@index([name])
}

// NEPLATITA | PLATITA_DOCTOR | PLATITA_TEHNICIAN
model Work {
  id            String      @id @default(cuid())
  entryDate     DateTime
  patientName   String
  observations  String?
  paymentStatus String      @default("NEPLATITA")
  doctor        Doctor      @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  doctorId      String
  technician1   Technician? @relation("WorkTechnician1", fields: [technician1Id], references: [id], onDelete: SetNull)
  technician1Id String?
  technician2   Technician? @relation("WorkTechnician2", fields: [technician2Id], references: [id], onDelete: SetNull)
  technician2Id String?
  technician3   Technician? @relation("WorkTechnician3", fields: [technician3Id], references: [id], onDelete: SetNull)
  technician3Id String?
  lines         WorkLine[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([doctorId])
  @@index([entryDate])
  @@index([paymentStatus])
  @@index([patientName])
}

model WorkLine {
  id                  String   @id @default(cuid())
  work                Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  workId              String
  workType            WorkType @relation(fields: [workTypeId], references: [id], onDelete: Restrict)
  workTypeId          String
  quantity            Int
  doctorUnitPrice     Int
  technicianUnitPrice Int
  createdAt           DateTime @default(now())

  @@index([workId])
  @@index([workTypeId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  before     String?
  after      String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model BackupRecord {
  id        String   @id @default(cuid())
  filePath  String
  sizeBytes Int
  type      String
  createdAt DateTime @default(now())
}
