// Billionaire Smile Club CRM — laborator dentar, offline, single-user.
// Sume în Int (bani / subunități monetare).

generator client {
  provider = "prisma-client-js"
  // Fără dot-prefix — electron-builder exclude implicit .prisma/ din pachet.
  output   = "../node_modules/prisma-client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AppAuth {
  id           String   @id @default("singleton")
  passwordHash String
  updatedAt    DateTime @updatedAt
}

// Cabinete / medici stomatologi (fostul modul Clienți).
model Doctor {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  works     Work[]
  rates     DoctorRate[]
  technicianRates TechnicianRate[]

  @@index([name])
}

model Technician {
  id         String   @id @default(cuid())
  name       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  worksAs1   Work[]   @relation("WorkTechnician1")
  worksAs2   Work[]   @relation("WorkTechnician2")
  worksAs3   Work[]   @relation("WorkTechnician3")
  workLines  WorkLine[]
  rates      TechnicianRate[]

  @@index([name])
  @@index([active])
}

// Catalog tipuri lucrări (nume). Prețurile reale sunt în DoctorRate / TechnicianRate.
model WorkType {
  id              String     @id @default(cuid())
  name            String
  doctorPrice     Int        @default(0)
  technicianPrice Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  lines           WorkLine[]
  doctorRates     DoctorRate[]
  technicianRates TechnicianRate[]

  @@index([name])
}

// Preț per doctor × tip lucrare (cât plătește cabinetul laboratorului).
model DoctorRate {
  id           String   @id @default(cuid())
  doctor       Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  doctorId     String
  workType     WorkType @relation(fields: [workTypeId], references: [id], onDelete: Cascade)
  workTypeId   String
  pricePerUnit Int
  updatedAt    DateTime @updatedAt

  @@unique([doctorId, workTypeId])
  @@index([doctorId])
  @@index([workTypeId])
}

// Preț per tehnician × doctor × tip lucrare (salariu tehnician).
model TechnicianRate {
  id           String     @id @default(cuid())
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  technicianId String
  doctor       Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  doctorId     String
  workType     WorkType   @relation(fields: [workTypeId], references: [id], onDelete: Cascade)
  workTypeId   String
  pricePerUnit Int
  updatedAt    DateTime   @updatedAt

  @@unique([technicianId, doctorId, workTypeId])
  @@index([technicianId])
  @@index([doctorId])
  @@index([workTypeId])
}

// NEPLATITA | PLATITA_DOCTOR | PLATITA_TEHNICIAN
model Work {
  id            String      @id @default(cuid())
  entryDate     DateTime
  patientName   String
  observations  String?
  paymentStatus String      @default("NEPLATITA")
  doctor        Doctor      @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  doctorId      String
  technician1   Technician? @relation("WorkTechnician1", fields: [technician1Id], references: [id], onDelete: SetNull)
  technician1Id String?
  technician2   Technician? @relation("WorkTechnician2", fields: [technician2Id], references: [id], onDelete: SetNull)
  technician2Id String?
  technician3   Technician? @relation("WorkTechnician3", fields: [technician3Id], references: [id], onDelete: SetNull)
  technician3Id String?
  lines         WorkLine[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([doctorId])
  @@index([entryDate])
  @@index([paymentStatus])
  @@index([patientName])
}

model WorkLine {
  id                  String      @id @default(cuid())
  work                Work        @relation(fields: [workId], references: [id], onDelete: Cascade)
  workId              String
  workType            WorkType    @relation(fields: [workTypeId], references: [id], onDelete: Restrict)
  workTypeId          String
  technician          Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  technicianId        String?
  quantity            Int
  doctorUnitPrice     Int
  technicianUnitPrice Int
  createdAt           DateTime    @default(now())

  @@index([workId])
  @@index([workTypeId])
  @@index([technicianId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  before     String?
  after      String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model BackupRecord {
  id        String   @id @default(cuid())
  filePath  String
  sizeBytes Int
  type      String
  createdAt DateTime @default(now())
}
